# Google OAuth web client ID (console.cloud.google.com → Credentials → OAuth client → Web).
# Authorised JavaScript origin: https://<sub>.qutrit.org
GOOGLE_CLIENT_ID=
# Long random string; changing it logs everyone out.
PADDY_SECRET=
# Comma-separated admin emails.
ADMIN_EMAILS=
# Local dev only: email-only login, insecure cookies.
DEV_LOGIN=0
